SECRET_KEY=<YOUR_SECRET_KEY>
DEBUG=True <SET_TO_FALSE_ON_PROD>
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_HOST=<DB_SERVER_HOST>
DB_PORT=<DB_SERVER_PORT>

# DEBUG=True writes each email to the runserver log. DEBUG=False sends through Resend.
# DEFAULT_FROM_EMAIL must be an address on a domain verified in Resend.
DEFAULT_FROM_EMAIL=<verified-sender@your-domain>
RESEND_API_KEY=<RESEND_API_KEY>

HOSTS = []

